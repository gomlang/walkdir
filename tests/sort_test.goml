package tests;

use ecosystem::walkdir;
use std::context;
use std::fs;
use std::io;
use std::testing;

fn reverse_name(left: string, right: string) -> isize {
    if left < right {
        1
    } else if left > right {
        -1
    } else {
        0
    }
}

fn paths(builder: walkdir::WalkDir, root: string) -> Vec[string] {
    let iterator = builder.iter();
    defer iterator.close();
    let result = Vec::new();
    for item in iterator {
        let entry = testing::expect_ok(item, "entry");
        result.push(entry.path().byte_slice(root.byte_len(), entry.path().byte_len()));
    }
    result
}

#[test]
fn custom_sort_preserves_depth_first_order_in_both_directions() -> () {
    let root = directory("sort-tree");
    defer {
        let _ = fs::remove_dir_all(root);
    };
    testing::assert_ok(fs::create_dir(root + "/b"));
    for name in["a", "c", "b/x", "b/y"] {
        testing::assert_ok(fs::write_file_structured(root + "/" + name, ""));
    }
    let original = walkdir::WalkDir::new(root);
    let sorted = original.sort_by_file_name(reverse_name);
    testing::assert(paths(sorted, root) == Vec::from_array(["", "/c", "/b", "/b/y", "/b/x", "/a"]));
    testing::assert(
        paths(sorted.contents_first(true), root)
            == Vec::from_array(["/c", "/b/y", "/b/x", "/b", "/a", ""]),
    );
    testing::assert(
        paths(original, root) == Vec::from_array(["", "/a", "/b", "/b/x", "/b/y", "/c"]),
    );
    testing::assert(
        paths(sorted.min_depth(1).max_depth(1), root) == Vec::from_array(["/c", "/b", "/a"]),
    );
    testing::assert(
        paths(sorted.filter_entry(|entry| entry.file_name() != Option::Some("b")), root)
            == Vec::from_array(["", "/c", "/a"]),
    );
}

#[test]
fn equal_names_use_deterministic_ties_and_replacing_comparator_is_lazy() -> () {
    let root = directory("sort-equal");
    defer {
        let _ = fs::remove_dir_all(root);
    };
    for name in["b", "a", "A", "B", "é"] {
        testing::assert_ok(fs::write_file_structured(root + "/" + name, ""));
    }
    let calls = Ref::new(0);
    let builder = walkdir::WalkDir::new(root).min_depth(1).sort_by_file_name(
        |_, _| {
            calls.set(calls.get() + 1);
            0
        },
    );
    testing::assert_eq(calls.get(), 0);
    testing::assert(paths(builder, root) == Vec::from_array(["/A", "/B", "/a", "/b", "/é"]));
    testing::assert(calls.get() > 0);
    calls.set(0);
    testing::assert(
        paths(builder.sort_by_file_name(reverse_name), root)
            == Vec::from_array(["/é", "/b", "/a", "/B", "/A"]),
    );
    testing::assert_eq(calls.get(), 0);
}

#[test]
fn sorting_callback_cancellation_and_close_release_descriptors() -> () {
    let root = directory("sort-cancel");
    defer {
        let _ = fs::remove_dir_all(root);
    };
    for name in["a", "b"] {
        testing::assert_ok(fs::write_file_structured(root + "/" + name, ""));
    }
    context::with_cancel(
        context::Context::background(),
        |ctx, cancel| {
            let iterator = walkdir::WalkDir::new(root).with_context(ctx).sort_by_file_name(
                |left, right| {
                    cancel.cancel();
                    reverse_name(left, right)
                },
            ).iter();
            let _ = next_entry(iterator);
            let error = testing::expect_err(
                testing::expect_some(iterator.next(), "error"),
                "cancelled",
            );
            testing::assert_eq(error.kind(), io::ErrorKind::Interrupted);
            testing::assert_none(iterator.next());
            testing::assert_eq(retained(root), 0);
        },
    );
    let handle: Ref[Option[walkdir::WalkIterator]] = Ref::new(Option::None);
    let iterator = walkdir::WalkDir::new(root).sort_by_file_name(
        |left, right| {
            if let Some(active) = handle.get() {
                active.close();
            }
            reverse_name(left, right)
        },
    ).iter();
    handle.set(Option::Some(iterator));
    let _ = next_entry(iterator);
    testing::assert_none(iterator.next());
    testing::assert_eq(retained(root), 0);
    handle.set(Option::None);
}
